  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "dev": "npm run build && npm run preview",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist/site",
